{
  "name": "@local/pixel-clock",
  "version": "1.8.0",
  "description": "Pixel Clock: a floating pixel planet pomodoro with a frosted pixel-font label. Defaults to a real always-on-top desktop window; switch between in-app and desktop in settings, resize the sphere, and use right-click for controls.",
  "type": "module",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "marquis-wang-wu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa0330/Pixel-Clock.git"
  },
  "homepage": "https://github.com/aa0330/Pixel-Clock",
  "bugs": {
    "url": "https://github.com/aa0330/Pixel-Clock/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pixel-clock",
    "pomodoro",
    "focus-timer",
    "webgl",
    "electron"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node smoke-test.cjs",
    "prepack": "npm run build && npm test"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "desktop/**",
    "build.mjs",
    "template.js",
    "src/planetShaders.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
